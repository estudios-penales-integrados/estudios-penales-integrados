---
import { SITE } from "../config/site";

const whatsappURL = `https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(
  SITE.whatsappMessage
)}`;
---

<section class="hero">

    <div class="container hero-grid">

        <div class="hero-content">

            <span class="hero-subtitle">

                ESTUDIOS PENALES INTEGRADOS

            </span>

            <h1>

                Defensa Penal Estratégica
                con compromiso y excelencia profesional.

            </h1>

            <p>

                Brindamos asesoramiento jurídico especializado
                en Derecho Penal, acompañando a cada cliente
                con una estrategia personalizada, confidencial
                y orientada a resultados.

            </p>

            <div class="hero-buttons">

                <a
                    href={whatsappURL}
                    class="btn"
                    target="_blank"
                    rel="noopener noreferrer"
                >

                    Solicitar consulta

                </a>

                <a
                    href="/servicios"
                    class="btn btn-outline"
                >

                    Ver servicios

                </a>

            </div>

        </div>

        <div class="hero-image">

            <img
                src="/logo.png"
                alt="Logo Estudios Penales Integrados"
            />

        </div>

    </div>

</section>
